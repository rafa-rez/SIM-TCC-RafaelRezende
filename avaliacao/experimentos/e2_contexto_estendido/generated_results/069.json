  "sql": "SELECT DISTINCT\n  pag.nom_credor AS nome_credor_prefeitura,\n  pag.num_doc_credor AS cnpj,\n  CAST(SUM(CAST(pag.vlr_pag_fonte AS DECIMAL)) AS DECIMAL) AS total_pago_prefeitura,\n  CAST(SUM(CAST(cgu.\"Valor Recebido\" AS DECIMAL)) AS DECIMAL) AS total_recebido_cgu\nFROM despesa_pagamento pag\nJOIN cgu_despesas_favorecidos cgu\n  ON CAST(pag.num_doc_credor AS VARCHAR) = CAST(cgu.\"Código Favorecido\" AS VARCHAR)\nWHERE pag.ano_referencia = 2024\n  AND cgu.ano_referencia = 2024\n  AND COALESCE(pag.nom_credor, '') NOT ILIKE '%NAO INFORMADO%'\n  AND pag.num_doc_credor NOT IN ('-1', '0')\nGROUP BY pag.nom_credor, pag.num_doc_credor\nORDER BY total_pago_prefeitura DESC\nLIMIT 50;",
