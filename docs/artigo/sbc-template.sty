\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2002/11/15]

% Margins: top=3.5cm, bottom=3.5cm, left=3cm, right=3cm, A4 paper
\RequirePackage[a4paper,top=3.5cm,bottom=3.5cm,left=3cm,right=3cm]{geometry}
\RequirePackage{times}

\pagestyle{empty}

\newcommand{\address}[1]{\gdef\@address{#1}}
\newcommand{\email}[1]{\gdef\@email{#1}}
\newcommand{\inst}[1]{\unskip$^{#1}$}

\def\maketitle{\par
 \begingroup
   \def\thefootnote{\fnsymbol{footnote}}
   \def\@makefnmark{\hbox to 0pt{$^{\@thefnmark}$\hss}}
   \long\def\@makefntext##1{\parindent 1em\noindent
            \hb@xt@1.8em{%
                \hss\@textsuperscript{\normalfont\@thefnmark}}##1}%
   \if@twocolumn
     \twocolumn[\@maketitle]
   \else
     \newpage
     \global\@topnum\z@
     \@maketitle
   \fi
   \thispagestyle{empty}\@thanks
 \endgroup
 \setcounter{footnote}{0}
 \let\maketitle\relax
 \let\@maketitle\relax
 \gdef\@thanks{}\gdef\@author{}\gdef\@title{}\let\thanks\relax}

\def\@maketitle{\newpage
 \null
 \begin{center}
  \vspace{0cm}
  {\Large\bf \@title \par}
  \vskip 1.5em
  {\large\bf \@author \par}
  \vskip 1em
  {\small \@address \par}
  \vskip 0.5em
  {\small\tt \@email \par}
 \end{center}
 \par
 \vskip 1.5em}

\renewenvironment{abstract}{%
      \begin{center}%
        {\bfseries \abstractname\vspace{-.5em}\vspace{\z@}}%
      \end{center}%
      \quotation\small}%
      {\endquotation}

\newenvironment{resumo}{%
      \begin{center}%
        {\bfseries Resumo\vspace{-.5em}\vspace{\z@}}%
      \end{center}%
      \quotation\small}%
      {\endquotation}

\def\section{\@startsection {section}{1}{\z@}{-3.5ex plus -1ex minus
 -.2ex}{2.3ex plus .2ex}{\large\bf}}
\def\subsection{\@startsection{subsection}{2}{\z@}{-3.25ex plus -1ex minus
 -.2ex}{1.5ex plus .2ex}{\normalsize\bf}}
\def\subsubsection{\@startsection{subsubsection}{3}{\z@}{-3.25ex plus
 -1ex minus -.2ex}{1.5ex plus .2ex}{\normalsize\bf}}

\setlength{\parindent}{1.27cm}
\setlength{\parskip}{0pt}
