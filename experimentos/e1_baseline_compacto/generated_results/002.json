  "sql": "WITH servidores_ativos AS (\n  SELECT\n    r.seq_dim_pessoa,\n    TRIM(UPPER(p.nom_pessoa)) AS nome_servidor,\n    MAX(CAST(r.vlr_rmn_liquida AS DECIMAL)) AS salario_maximo\n  FROM remuneracao_municipio r\n  JOIN pessoa_municipio p ON r.seq_dim_pessoa = p.seq_dim_pessoa\n  WHERE r.ano_referencia = 2024\n    AND r.dsc_sit_serv_pens ILIKE '%Ativo%'\n  GROUP BY r.seq_dim_pessoa, nome_servidor\n),\nbeneficios_nbf AS (\n  SELECT\n    TRIM(UPPER(\"NOME FAVORECIDO\")) AS nome_beneficiario,\n    SUM(CAST(\"VALOR PARCELA\" AS DECIMAL)) AS total_beneficio\n  FROM cgu_novo_bolsa_familia\n  WHERE ano_referencia = 2024\n  GROUP BY nome_beneficiario\n)\nSELECT\n  s.nome_servidor AS nome,\n  s.salario_maximo AS salario_maximo,\n  b.total_beneficio AS total_beneficio_federal\nFROM servidores_ativos s\nJOIN beneficios_nbf b ON s.nome_servidor = b.nome_beneficiario\nORDER BY s.nome_servidor;",
