  "source": "generated:e1_baseline_compacto",
  "sql": "WITH servidores_ativos AS ( SELECT p.seq_dim_pessoa, p.nom_pessoa, p.num_documento, MAX(CAST(r.vlr_rmn_liquida AS DECIMAL)) AS maior_salario FROM remuneracao_municipio r JOIN pessoa_municipio p ON r.seq_dim_pessoa = p.seq_dim_pessoa WHERE r.ano_referencia = 2025 AND r.dsc_sit_serv_pens ILIKE '%Ativo%' AND COALESCE(p.nom_pessoa, '') NOT ILIKE '%NAO INFORMADO%' GROUP BY p.seq_dim_pessoa, p.nom_pessoa, p.num_documento ), bpc_2025 AS ( SELECT TRIM(UPPER(\"NOME BENEFICIÁRIO\")) AS nome_bpc FROM cgu_bpc WHERE ano_referencia = 2025 ) SELECT sa.nom_pessoa, sa.num_documento FROM servidores_ativos sa JOIN bpc_2025 b ON TRIM(UPPER(sa.nom_pessoa)) = b.nome_bpc LIMIT 50;",
