  "source": "generated:e1_baseline_compacto",
  "sql": "WITH pagamentos AS ( SELECT TRIM(UPPER(nom_credor)) AS nome, SUM(CAST(vlr_pag_fonte AS DECIMAL)) AS total_pagamento FROM despesa_pagamento WHERE ano_referencia = 2024 AND COALESCE(nom_credor, '') NOT ILIKE '%NAO INFORMADO%' AND num_doc_credor NOT IN ('-1', '0') GROUP BY TRIM(UPPER(nom_credor)) ), bolsa_familia AS ( SELECT TRIM(UPPER(\"NOME FAVORECIDO\")) AS nome, SUM(CAST(\"VALOR PARCELA\" AS DECIMAL)) AS total_bolsa FROM cgu_bolsa_familia_pagamentos WHERE ano_referencia = 2024 GROUP BY TRIM(UPPER(\"NOME FAVORECIDO\")) ) SELECT COALESCE(p.nome, b.nome) AS nome, COALESCE(p.total_pagamento, 0) AS total_pagamento, COALESCE(b.total_bolsa, 0) AS total_bolsa_familia FROM pagamentos p FULL OUTER JOIN bolsa_familia b ON p.nome = b.nome ORDER BY nome LIMIT 50;",
