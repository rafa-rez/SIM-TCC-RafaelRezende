  "sql": "WITH licitacoes_agrupadas AS (\n  SELECT\n    seq_licitacao,\n    ano_referencia,\n    SUM(CAST(vlr_empenhado AS DECIMAL)) AS valor_empenhado\n  FROM licitacao_licitacao\n  WHERE ano_referencia IN (2024, 2025)\n  GROUP BY seq_licitacao, ano_referencia\n), ranked_licitacoes AS (\n  SELECT\n    seq_licitacao,\n    ano_referencia,\n    valor_empenhado,\n    ROW_NUMBER() OVER (PARTITION BY ano_referencia ORDER BY valor_empenhado DESC) AS rn\n  FROM licitacoes_agrupadas\n)\nSELECT\n  seq_licitacao,\n  ano_referencia,\n  valor_empenhado\nFROM ranked_licitacoes\nWHERE rn <= 5\nORDER BY ano_referencia, valor_empenhado DESC;",
