  "sql": "WITH servidores_ativos AS (\n  SELECT\n    r.seq_dim_pessoa,\n    p.nom_pessoa,\n    MAX(CAST(r.vlr_rmn_liquida AS DECIMAL)) AS salario_maximo\n  FROM remuneracao_municipio r\n  JOIN pessoa_municipio p ON r.seq_dim_pessoa = p.seq_dim_pessoa\n  WHERE r.ano_referencia = 2024\n    AND r.dsc_sit_serv_pens ILIKE '%Ativo%'\n    AND COALESCE(p.nom_pessoa, '') NOT ILIKE '%NAO INFORMADO%'\n  GROUP BY r.seq_dim_pessoa, p.nom_pessoa\n),\nbeneficios_nbf AS (\n  SELECT\n    TRIM(UPPER(\"NOME FAVORECIDO\")) AS nome_favorecido,\n    SUM(CAST(\"VALOR PARCELA\" AS DECIMAL)) AS total_beneficio\n  FROM cgu_novo_bolsa_familia\n  WHERE ano_referencia = 2024\n    AND COALESCE(\"NOME FAVORECIDO\", '') NOT ILIKE '%NAO INFORMADO%'\n  GROUP BY TRIM(UPPER(\"NOME FAVORECIDO\"))\n)\nSELECT\n  s.nom_pessoa AS nome_servidor,\n  s.salario_maximo,\n  b.total_beneficio\nFROM servidores_ativos s\nJOIN beneficios_nbf b ON TRIM(UPPER(s.nom_pessoa)) = b.nome_favorecido\nORDER BY s.nom_pessoa\nLIMIT 50;",
