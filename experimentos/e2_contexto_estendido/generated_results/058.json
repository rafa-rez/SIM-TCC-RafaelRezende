  "sql": "WITH servidores_ativos AS (\n  SELECT\n    r.seq_dim_pessoa,\n    p.nom_pessoa,\n    p.num_documento\n  FROM remuneracao_municipio r\n  JOIN pessoa_municipio p ON r.seq_dim_pessoa = p.seq_dim_pessoa\n  WHERE r.ano_referencia = 2025\n    AND r.dsc_sit_serv_pens ILIKE '%Ativo%'\n    AND COALESCE(p.nom_pessoa, '') NOT ILIKE '%NAO INFORMADO%'\n), bpc_2025 AS (\n  SELECT\n    \"NOME BENEFICIÁRIO\"\n  FROM cgu_bpc\n  WHERE ano_referencia = 2025\n)\nSELECT\n  sa.nom_pessoa AS nome_servidor,\n  sa.num_documento AS cpf_servidor\nFROM servidores_ativos sa\nJOIN bpc_2025 b ON TRIM(UPPER(sa.nom_pessoa)) = TRIM(UPPER(b.\"NOME BENEFICIÁRIO\"))\nLIMIT 50;",
