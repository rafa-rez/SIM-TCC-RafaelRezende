  "source": "generated:e4_gpt4o",
  "sql": "WITH servidores_ativos AS (SELECT r.seq_dim_pessoa, TRIM(UPPER(p.nom_pessoa)) AS nome_servidor FROM remuneracao_municipio r JOIN pessoa_municipio p ON r.seq_dim_pessoa = p.seq_dim_pessoa WHERE r.dsc_sit_serv_pens ILIKE '%Ativo%' AND r.ano_referencia = 2025), bpc_beneficiarios AS (SELECT TRIM(UPPER(\"NOME BENEFICIÁRIO\")) AS nome_beneficiario, SUM(CAST(\"VALOR PARCELA\" AS DECIMAL)) AS valor_bpc FROM cgu_bpc WHERE ano_referencia = 2025 GROUP BY nome_beneficiario) SELECT sa.nome_servidor, bb.valor_bpc FROM servidores_ativos sa JOIN bpc_beneficiarios bb ON sa.nome_servidor = bb.nome_beneficiario;",
