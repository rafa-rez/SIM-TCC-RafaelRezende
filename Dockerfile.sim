FROM python:3.11-slim

WORKDIR /workspace

# Instala apenas as dependências enxutas do servidor SIM v3.0 na camada da imagem
# (evita rodar pip install a cada inicialização do container)
RUN pip install --no-cache-dir \
    "fastapi>=0.110.0" \
    "uvicorn>=0.29.0" \
    "duckdb>=1.1.0" \
    "sqlglot>=25.0.0" \
    "pydantic>=2.7.0" \
    "requests>=2.31.0" \
    "python-dotenv>=1.0.0"

ENV PYTHONPATH=/workspace

EXPOSE 8000

CMD ["uvicorn", "sim_platform.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
